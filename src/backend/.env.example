# Copy to src/backend/.env and fill in. `.env` is gitignored; `.env.example` is not.
# `make backend` / `make dev` source this file (see Makefile). A bare
# `uvicorn api.main:app` does NOT — export the vars yourself, or use make.
#
# Only the Earth Engine layers need any of this. Every other route works with
# the whole file absent.

# --- Earth Engine (optional: /flood/* and /land/* tiles) ---------------------
# Google Cloud project id with the Earth Engine API enabled AND registered for
# Earth Engine access (https://code.earthengine.google.com/register).
# Whoever runs the backend must be a member of this project.
GEE_PROJECT=

# Pick ONE credential path:
#
# (a) Laptop, per-developer: leave the two vars below empty and run once
#       gcloud auth application-default login   # or: earthengine authenticate
#     Nothing secret gets shared. This is the normal path for a teammate.
#
# (b) Headless / shared: a service-account key. The JSON key is a CREDENTIAL —
#     send it over a private channel, never commit it, never paste it in chat.
#     Path is to the file, not its contents.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_FILE=

# Optional. Only needed to read the DSWFP daily-water assets that
# data/prepare_dswfp.py exports; `make backend` derives it from GEE_PROJECT.
# Set this explicitly to the existing asset path before switching GEE_PROJECT.
# GEE_DSWFP_ASSET_ROOT=projects/<project-id>/assets/dswfp

# --- Agent --------------------------------------------------------
# Unset = deterministic fallback loop, same SSE events. Set = real Claude
# tool-calling. This is a billed key; treat it like the JSON key above.
ANTHROPIC_API_KEY=

# --- Durable map cache (optional; otherwise local SQLite) ----------------------
# Apply supabase/migrations first. Only the backend may receive this secret key.
# Map metadata goes to Postgres; image bytes go to the private map-cache bucket.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# MAP_CACHE_PATH=/persistent/local-buffer/maps.sqlite3

# --- Confluence (optional: /confluence/* read-only doc fetch) ----------------
# API token, own Atlassian account: https://id.atlassian.com/manage-profile/security/api-tokens
# Treat it like the GEE service-account key above — send over a private
# channel, never commit it, never paste it in chat.
CONFLUENCE_SITE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Optional — scopes /confluence/search to one space when set.
CONFLUENCE_SPACE_KEY=

# --- Demo ---------------------------------------------------------------------
# 1 = serve the synthetic fixture population everywhere. Leave unset for a live demo.
# USE_FIXTURE=1
